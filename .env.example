# Local development only. npm run setup:local creates .env with a random password.
# DATABASE_URL and TEST_DATABASE_URL MUST point to separate databases.
PG_LOCAL_USER=ocs_answer_hub
PG_LOCAL_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
PG_LOCAL_PORT=15432
DATABASE_URL=postgresql://ocs_answer_hub:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/ocs_answer_hub_dev
TEST_DATABASE_URL=postgresql://ocs_answer_hub:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/ocs_answer_hub_test
# Explicit consent to reset ONLY the dedicated _test database.
TEST_DATABASE_RESET=1
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=18771
STATE_DIR=./state
# Empty: automatically generate and persist state/master.key. Never commit it.
# MASTER_KEY=64_HEX_CHARACTERS
# Exact hostname/IP allow-list for private upstreams; empty by default.
UPSTREAM_ALLOW_HOSTS=
# Optional browser overrides. Otherwise Playwright's installed Chromium is used.
# BROWSER_EXECUTABLE_PATH=/path/to/chrome
# EVIDENCE_DIR=./artifacts/verification

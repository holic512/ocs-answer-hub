# 本地开发配置示例。运行 npm run setup:local 自动生成 .env 和随机密码。
# 使用已有数据库时，只需填写下方五项；密码按原文填写，无需 URL 编码。
# 值包含 #、空格等字符时请用双引号包裹；密码内含双引号时可用单引号包裹。

# ── 数据库（必填）──
# 数据库服务器地址（不含协议）。
DB_HOST=127.0.0.1
# PostgreSQL 默认端口为 5432；本项目本地 Docker 映射端口为 15432。
DB_PORT=15432
# 数据库名称，需提前创建；本地 Docker 首次启动会自动创建。
DB_NAME=ocs_answer_hub_dev
# 数据库登录用户名。
DB_USER=ocs_answer_hub
# 数据库登录密码。
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# ── 应用访问（通常保持默认）──
# 浏览器实际访问地址：开发前端为 5173；构建后直连后端改为 18771。
APP_ORIGIN=http://127.0.0.1:5173
# 后端监听地址和端口，仅本机访问时保持 127.0.0.1。
HOST=127.0.0.1
PORT=18771
# 保存加密主密钥及持久文件；请持久保存，不要提交到 Git。
STATE_DIR=./state

# ── 测试专用（不运行数据库测试可留空）──
# 复用上面的数据库地址、端口和账号；必须是独立的、以 _test 结尾的库。
TEST_DB_NAME=ocs_answer_hub_test
# 1 表示允许清空专用测试库。默认关闭；运行集成测试或完整验收前手动改为 1。
TEST_DATABASE_RESET=0

# ── 高级可选项（无需使用时保持空值或注释）──
# 允许访问的私网上游主机/IP，多个用英文逗号分隔，默认不开放私网上游。
UPSTREAM_ALLOW_HOSTS=
# 不填则自动生成 STATE_DIR/master.key；已有数据后不可随意更换。
# MASTER_KEY=填写64位十六进制密钥
# 浏览器验收用 Chrome/Chromium 可执行文件路径，未设置则使用 Playwright Chromium。
# BROWSER_EXECUTABLE_PATH=/path/to/chrome
# 测试证据输出目录。
# EVIDENCE_DIR=./artifacts/verification

# 知序服务器运行配置。修改后执行 docker compose restart app 即可重新读取。
# 首次生成后填写数据库连接信息。不要将真实密码和密钥提交到 Git。
# 每项单独一行；包含 # 或空格的值必须用引号包裹，不支持跨行字符串。

# 数据库地址：填写容器所在网络能访问的地址，而不是宿主机的 localhost。
DB_HOST=postgres
# PostgreSQL 端口。
DB_PORT=5432
# 已创建的数据库名称。
DB_NAME=answer_hub
# 数据库用户名。
DB_USER=answer_hub
# 数据库密码，必须填写原文，无需 URL 编码。
DB_PASSWORD=

# 浏览器实际访问地址，例如 https://questions.example.com，不带末尾斜杠。
APP_ORIGIN=http://127.0.0.1:18771

# 高级可选项：私网上游主机/IP 白名单，多个用英文逗号分隔。
UPSTREAM_ALLOW_HOSTS=
# 高级可选项：不填则在 storage/master.key 中自动生成并持久保存，已有数据后不要更换。
MASTER_KEY=

# 以下选项通常保持默认；旧配置未包含这些字段时，升级自动使用相同默认值。
# HOST=0.0.0.0
# PORT=18771
# STATE_DIR=/app/storage
# 修改 PORT 时须同步调整 compose.yml 容器目标端口并重新创建容器。

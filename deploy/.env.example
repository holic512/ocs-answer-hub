# 新部署示例。复制到项目根 .env 后填写；不要覆盖已有生产配置。
# 数据库密码直接填写，无需 URL 编码；包含 # 或空格时用引号包裹。

# ── 数据库（必填）──
# 容器中可访问的数据库地址；使用外部 Docker 网络时可填数据库服务名。
# 数据库服务器地址（不含协议）。
DB_HOST=postgres
DB_PORT=5432
# 数据库名称，需提前创建；本地 Docker 首次启动会自动创建。
DB_NAME=answer_hub
# 数据库登录用户名。
DB_USER=answer_hub
# 数据库登录密码。
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# ── 应用访问（必填）──
# 浏览器实际访问的 HTTPS 地址，不带末尾斜杠。
APP_ORIGIN=https://questions.example.com
# 已有数据库所属的 Docker 外部网络名称。
DATABASE_NETWORK=your-existing-database-network

# ── 高级可选项 ──
# 私网上游主机/IP 白名单，多个用英文逗号分隔；不使用时留空。
UPSTREAM_ALLOW_HOSTS=
# 不填则自动生成并保存 /app/state/master.key；必须持久保管。
# MASTER_KEY=填写64位十六进制密钥
# 容器监听地址、端口和状态目录由 compose.yaml 设置，无需在这里重复填写。
# 生产环境不要配置 TEST_DB_NAME 或开启 TEST_DATABASE_RESET。

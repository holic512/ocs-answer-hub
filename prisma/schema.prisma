// 知序数据库结构。迁移命令见 docs/DATABASE_AND_VERSIONING.md，勿修改已发布迁移。
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model administrators {
  sessions sessions[]
  api_tokens api_tokens[]
  query_events query_events[]
  background_jobs background_jobs[]
  id            Int      @id @default(autoincrement())
  role String @default("user")
  disabled Boolean @default(false)
  daily_limit Int @default(2000)
  rpm Int @default(60)
  usage_day DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  day_count Int @default(0)
  minute_bucket DateTime @default(dbgenerated("date_trunc('minute'::text, now())")) @db.Timestamptz(6)
  minute_count Int @default(0)
  username      String   @unique
  password_hash String
  must_change   Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}
model sessions {
  administrator administrators @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id Int @default(1)
  @@index([user_id], map: "sessions_user_idx")
  hash       String   @id
  csrf       String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
model providers {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  kind          String
  enabled       Boolean  @default(false)
  priority      Int
  timeout_ms    Int      @default(12000)
  config_cipher String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}
model api_tokens {
  administrator administrators @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id Int @default(1)
  @@index([user_id], map: "tokens_user_idx")
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  hash          String    @unique
  prefix        String
  expires_at    DateTime? @db.Timestamptz(6)
  revoked       Boolean   @default(false)
  daily_limit   Int       @default(2000)
  rpm           Int       @default(60)
  usage_day     DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  day_count     Int       @default(0)
  minute_bucket DateTime  @default(dbgenerated("date_trunc('minute'::text, now())")) @db.Timestamptz(6)
  minute_count  Int       @default(0)
  last_used     DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
}
model questions {
  generation_task background_jobs? @relation(fields: [generation_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vector question_vectors?
  vector_skip vector_index_skips?
  generation_previews generation_previews[]
  generation_task_id String? @db.Uuid
  generation_round Int?
  generation_model String?
  @@index([generation_task_id], map: "questions_generation_idx")
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint   String   @unique
  title         String
  normal_title  String
  type          String
  options       Json     @default("[]")
  images        Json     @default("[]")
  course        String   @default("")
  answer        String
  source        String
  verified      Boolean  @default(false)
  conflict      Boolean  @default(false)
  deleted       Boolean  @default(false)
  hit_count     Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  versions      answer_versions[]
  @@index([normal_title], map: "question_title_idx")
  @@index([normal_title(ops: raw("gin_trgm_ops"))], type: Gin, map: "question_trgm_idx")
  @@index([created_at(sort: Desc)], map: "question_created_idx")
}
model answer_versions {
  id          BigInt    @id @default(autoincrement())
  question_id String    @db.Uuid
  answer      String
  source      String
  verified    Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  question    questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
model query_events {
  administrator administrators? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_id Int?
  @@index([user_id,created_at(sort: Desc)], map: "events_user_date_idx")
  id          BigInt   @id @default(autoincrement())
  token_id    String?  @db.Uuid
  title       String
  status      String
  source      String?
  question_id String?  @db.Uuid
  duration_ms Int
  attempts    Json     @default("[]")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  @@index([created_at(sort: Desc)], map: "events_date_idx")
}
model provider_observations {
  id              BigInt   @id @default(autoincrement())
  fingerprint     String
  title           String
  source          String
  status          String
  response_cipher String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  @@index([fingerprint], map: "observation_key_idx")
}
model settings {
  id    Int  @id
  value Json @default("{}")
}
// 保留旧系统的迁移记录，用于已有数据库平滑接入。
model schema_migrations {
  version    String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

// 后台任务由 PostgreSQL 租约调度，SQL 外键与 CHECK 见增量迁移。
model background_jobs {
 administrator administrators @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
 questions questions[]
 previews generation_previews[]
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 kind String
 user_id Int
 provider_id String? @db.Uuid
 course String @default("")
 status String @default("queued")
 max_rounds Int @default(1)
 max_questions Int @default(10)
 batch_size Int @default(10)
 round Int @default(0)
 accepted Int @default(0)
 attempts Int @default(0)
 max_attempts Int @default(3)
 cancel_requested Boolean @default(false)
 lease_until DateTime? @db.Timestamptz(6)
 lease_token String? @db.Uuid
 cursor_id String? @db.Uuid
 processed Int @default(0)
 skipped_count Int @default(0)
 error String?
 created_at DateTime @default(now()) @db.Timestamptz(6)
 updated_at DateTime @default(now()) @db.Timestamptz(6)
 @@index([status,lease_until,created_at], map: "jobs_claim_idx")
}
model question_vectors {
 question questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
 question_id String @id @db.Uuid
 embedding Unsupported("vector(512)")
 content_hash String
 model String
 updated_at DateTime @default(now()) @db.Timestamptz(6)
 // HNSW vector_cosine_ops 由 SQL 迁移维护，Prisma 不支持该索引类型。
}
model generation_previews {
 job background_jobs @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
 question questions? @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
 id BigInt @id @default(autoincrement())
 job_id String @db.Uuid
 round Int
 question_id String? @db.Uuid
 data Json
 status String
 reason String?
 created_at DateTime @default(now()) @db.Timestamptz(6)
 @@index([job_id,id], map: "generation_previews_job_idx")
}
model vector_index_skips {
 question questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
 question_id String @id @db.Uuid
 content_hash String
 model String
 reason String
 updated_at DateTime @default(now()) @db.Timestamptz(6)
}

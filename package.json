{
  "name": "ocs-answer-hub",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "知序：兼容 OCS 的单用户本地优先题库服务",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:stop": "docker compose -f compose.dev.yaml stop",
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run db:generate && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "test:browser": "node --env-file-if-exists=.env --import tsx scripts/browser-acceptance.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "verify": "node --env-file-if-exists=.env scripts/verify.mjs",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate status",
    "db:migration": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev --create-only --name",
    "prepare": "node scripts/install-hooks.mjs",
    "postinstall": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^1.65.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "undici": "^7.16.0",
    "zod": "^4.1.12",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
